{
  "compilerOptions": {
    "skipLibCheck": true,
    "target": "ES2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "strict": false,
    "allowJs": true,
    "outDir": "./dist"
  },
  "include": [
    "**/*.js",
    "**/*.mjs",
    "**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}